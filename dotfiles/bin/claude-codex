#!/usr/bin/env bash
set -euo pipefail

# Keep this launch isolated from any direct Anthropic or cloud-provider setup.
unset ANTHROPIC_API_KEY
unset CLAUDE_CODE_USE_BEDROCK
unset CLAUDE_CODE_USE_FOUNDRY
unset CLAUDE_CODE_USE_VERTEX

export ANTHROPIC_BASE_URL="http://127.0.0.1:18765"
export ANTHROPIC_AUTH_TOKEN="unused"
export ANTHROPIC_MODEL="fable[1m]"
export ANTHROPIC_SMALL_FAST_MODEL="haiku[1m]"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="272000"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK="1"

exec claude --dangerously-skip-permissions "$@"
